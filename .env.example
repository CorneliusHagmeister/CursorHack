# Optional. Demo runs without these (seed catalogue + file/memory orders).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project: indigo-lane (eu)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the new publishable key from the dashboard; anon key still works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Negotiation API — all optional
# AI_GATEWAY_API_KEY=         # Vercel AI Gateway key — merchant replies phrased by Claude (preferred)
# ANTHROPIC_API_KEY=          # or call the Claude API directly; templates if neither is set
# KV_REST_API_URL=            # Redis REST (Upstash / Vercel KV) for sessions; in-memory without it
# KV_REST_API_TOKEN=
# PUBLIC_BASE_URL=            # overrides the server URL in /api/openapi.json
